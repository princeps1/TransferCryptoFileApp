<!-- TRANSFER -->
<div class="container transfer" id="transfer">
    <div class="form-container">
        <h3>Upload File To Encode From Target Folder</h3>
        <input type="file" id="fileEncode" disabled />
        <label><input type="checkbox" name="option" class="checkbox" value="Railfence" /> Railfence cipher</label>
        <label><input type="checkbox" name="option" class="checkbox" value="XXTEA" /> XXTEA</label>
        <label><input type="checkbox" name="option" class="checkbox" value="XXTEACBC" /> XXTEA – CBC</label>
        <button id="encode-btn" disabled>Encode</button>
    </div>

    <div class="form-container">
        <h3>Selected File To Send</h3>

        <!-- New inputs for host and port -->
        <input type="text"
               id="hostInput"
               placeholder="Host (e.g., localhost)" />
        <input type="number"
               id="portInput"
               placeholder="Port (e.g., 9001)" />

        <!-- File picker -->
        <input type="file" id="fileSend" />

        <!-- Send button, disabled until a file is chosen -->
        <button id="send-btn" disabled>Send</button>
    </div>
</div>

