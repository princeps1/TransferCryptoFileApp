<!-- TRANSFER -->
<div class="container transfer" id="transfer">
    <!-- ENCODE SECTION (unchanged) -->
    <div class="form-container">
        <h3>Upload File To Encode </h3>
        <input type="file" id="fileEncode" disabled />
        <label><input type="checkbox" name="option" class="checkbox" value="Railfence" /> Railfence cipher</label>
        <label><input type="checkbox" name="option" class="checkbox" value="XXTEA" /> XXTEA</label>
        <label><input type="checkbox" name="option" class="checkbox" value="XXTEACBC" /> XXTEA – CBC</label>
        <button id="encode-btn" disabled>Encode</button>
    </div>

    <!-- SEND / SERVER SECTION -->
    <div class="form-container">
        <h3>Selected File To Send</h3>

        <!-- SERVER TOGGLE -->
        <label>
            <input type="checkbox" id="serverToggle" />
            Act as server
        </label>
        <input type="number"
               id="serverPort"
               placeholder="Server Port (e.g. 9001)" />

        <!-- CLIENT CONTROLS -->
        <input type="text" id="hostInput" placeholder="Host (e.g., localhost)" />
        <input type="number" id="portInput" placeholder="Port (e.g., 9001)" />
        <input type="file" id="fileSend" />
        <button id="send-btn" disabled>Send</button>
    </div>

    <!-- DECODE SECTION -->
    <div class="form-container">
        <h3>Upload File To Decode From Target </h3>
        <input type="file" id="fileDecode" disabled />
        <label><input type="checkbox" name="decryptOption" class="checkbox-decrypt" value="Railfence" /> Railfence cipher</label>
        <label><input type="checkbox" name="decryptOption" class="checkbox-decrypt" value="XXTEA" /> XXTEA</label>
        <label><input type="checkbox" name="decryptOption" class="checkbox-decrypt" value="XXTEACBC" /> XXTEA – CBC</label>
        <button id="decode-btn" disabled>Decode</button>
    </div>

</div>


